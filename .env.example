# ======================================================================
# Health Claim Decision Agent - environment configuration (EXAMPLE)
# Copy to ".env" and fill in real values. NEVER commit a real .env.
# SYNTHETIC DATA ONLY - not for real insurance or medical use.
# ======================================================================

# --- Core ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Comma-separated; do NOT use "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (used from Phase 2 onward; PostgreSQL + pgvector) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/healthclaim
DATABASE_USERNAME=healthclaim
DATABASE_PASSWORD=change-me
# Host port to publish the dev Postgres container on. Change this (and the port
# in DATABASE_URL) if 5432 is already used by a local PostgreSQL install.
DB_HOST_PORT=5432

# --- Mercury via OpenRouter (chat: claim extraction + explanation) ---
# OpenAI-compatible endpoint. Set MERCURY_MODEL to the EXACT slug shown on your
# OpenRouter dashboard (free variants typically end in ":free").
MERCURY_PROVIDER=openrouter
MERCURY_BASE_URL=https://openrouter.ai/api/v1
MERCURY_API_KEY=sk-or-your-key-here
MERCURY_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Embeddings (SEPARATE provider; see app.embedding.*) ---
# provider=local  -> dependency-free deterministic embedder (DEFAULT; no key, offline).
#                    Great for dev/CI; NOT semantic-quality. 384 dims.
# provider=openai-compatible -> calls POST {EMBEDDING_BASE_URL}/embeddings with your key.
# EMBEDDING_DIM MUST equal the model's output dimension AND the migrated pgvector
# column; the app fails fast at startup on a mismatch.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=384
# Extras for asymmetric / resizable hosted models. Example: NVIDIA NIM (free key at build.nvidia.com)
#   EMBEDDING_PROVIDER=openai-compatible
#   EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
#   EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
#   EMBEDDING_API_KEY=nvapi-your-key-here
#   EMBEDDING_QUERY_INPUT_TYPE=query
#   EMBEDDING_PASSAGE_INPUT_TYPE=passage
#   EMBEDDING_REQUEST_DIMENSIONS=true   # 2048-d model shortened to EMBEDDING_DIM=384
#   EMBEDDING_TRUNCATE=END
#   EMBEDDING_BATCH_SIZE=1             # NVIDIA's free endpoint fails multi-input batches intermittently
EMBEDDING_QUERY_INPUT_TYPE=
EMBEDDING_PASSAGE_INPUT_TYPE=
EMBEDDING_REQUEST_DIMENSIONS=false
EMBEDDING_TRUNCATE=
EMBEDDING_BATCH_SIZE=32

# --- RAG retrieval ---
RAG_TOP_K=5
RAG_MAX_SNIPPET_LENGTH=500

# --- AI resilience ---
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# --- Object storage (local filesystem for dev; S3-compatible for deploy) ---
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Security (used from the security phase onward) ---
# Use a long, random value (>= 32 bytes). Never commit a real secret.
JWT_SECRET=change-me-with-a-long-random-value-at-least-32-bytes
JWT_EXPIRATION_MINUTES=120

# Default DEV users are seeded only under the 'dev' profile (synthetic, dev-only).
# Create real users via POST /api/v1/admin/users in production.
# Seeded usernames: admin (ADMIN), reviewer (REVIEWER), user (USER).
SEED_ADMIN_PASSWORD=admin-dev-password
SEED_REVIEWER_PASSWORD=reviewer-dev-password
SEED_USER_PASSWORD=user-dev-password

# --- AI judge ---
# llm             -> the chat model above answers in a strict JSON schema (default)
# decision-model  -> a dedicated decision model via OpenRouter's Decisions API
#                    (POST /api/alpha/decisions); returns a probability per outcome.
#                    Uses MERCURY_API_KEY unless DECISION_MODEL_API_KEY is set.
DECISION_ENGINE=llm
DECISION_MODEL=parallel/decisions-fast:free
